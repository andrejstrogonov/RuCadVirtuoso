@startuml requirements_traceability
title Требования и трассировка: T1–T15, сценарии и этапы (ТЗ п. 12.2, 15.1)

package "Этап E0 — каркас ядра" {
  usecase "T1 MNA: делитель R-R\n(1e-12)" as T1
  usecase "T2 RC-заряд TRAN\n(1e-3)" as T2
  usecase "T3 RLC AC: резонанс\n(f ±1%, Q ±2%)" as T3
  usecase "T15 Висящий узел:\nошибка до решения" as T15
}

package "Этап E1 — приборы" {
  usecase "T4 MOSFET: 3 области\n(1e-3)" as T4
  usecase "T5 Мемристор M1:\nпетля I-V, x∈[0,1]" as T5
  usecase "T6 Мемристор:\nпорог, Δx < 1e-6" as T6
  usecase "T7 GEM: 10 импульсов\n→ ступени ids" as T7
  usecase "T8 Нейристор N1/N2:\nспайки, f ∝ I_in" as T8
  usecase "T13 Кроссбар 16×16,\n10 000 точек ≤ 120 с" as T13
}

package "Этап E2 — Verilog-A" {
  usecase "T9 VA-резистор\n(1e-9)" as T9
  usecase "T10 VA ddt:\nнелинейная ёмкость (1e-3)" as T10
  usecase "T11 VA-ошибки:\nсообщение, нет падения" as T11
}

package "Этап E3 — редактор схем" {
  usecase "S1 Проверка ВАХ\nмемристора" as S1
  usecase "S2 Импорт\nсвоей модели" as S2
  usecase "S3 Нейристорный\nнейрон" as S3
  usecase "S4 Кроссбар 4×4\nчерез subckt" as S4
  usecase "T12 Иерархия subckt\n3 уровня" as T12
  usecase "T14 Разрыв PULSE:\nпопадание во фронт" as T14
}

actor "CI (Windows headless)" as CI
actor "Инженер" as U

T1 --> CI
T2 --> CI
T3 --> CI
T15 --> CI
T4 --> CI
T5 --> CI
T6 --> CI
T7 --> CI
T8 --> CI
T13 --> CI
T9 --> CI
T10 --> CI
T11 --> CI
T12 --> CI
T14 --> CI

S1 --> U
S2 --> U
S3 --> U
S4 --> U

S1 ..> T5 : «проверяется»
S3 ..> T8
S2 ..> T9

note right of T13
  NFR-PERF-002 (эталонная машина 8 ядер/16 ГБ/SSD).
  Гейт этапа E1.
end note

note bottom of S4
  DoD MVP (ТЗ 4.3): все T1–T15 зелёные в CI,
  S1–S4 проходят через UI-API,
  установщик ставит приложение на чистую Windows.
end note

@enduml
