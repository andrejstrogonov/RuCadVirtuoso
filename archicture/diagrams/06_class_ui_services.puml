@startuml class_ui_services
title Классы сервисов и UI (MVP)

package "rcad.services" {
  class ProjectService {
    +create(path, name) : ProjectDoc
    +add_cell(doc, schematic) : CellSchema
    +save(doc)
    +autosave(doc, changed_cells)
    +open(path) : ProjectDoc
    +path(doc) : Path
  }
  class ProjectDoc {
    +root: Path
    +schema: ProjectSchema
    +cells: dict[str, CellSchema]
    +model_manager: ModelManager
    +diagnostics: list[Diagnostic]
    +cell_names : list[str]
    +cell(name) : CellSchema
  }
  class Netlister <<module-функции>> {
    +netlist_for(project, cell, dc/tran/ac) : str
    +export_netlist(project, cell) : str
    +import_netlist(project, text, main) : list[Diagnostic]
    +resolve_bindings(project, cell)
    +next_net_name(existing) : str
    +validate_net_name(name, existing)
  }
  class ModelManager {
    +library_names() : list[str]
    +entry(cell) : ModelEntry
    +symbol(cell) : SymbolSchema
    +symbol_for(name) : SymbolSchema
    +params_for(master) : list[ParamSpec]
    +panel_cells() : list[ModelEntry]
    +reload()
  }
  class SimulatorService <<Qt, dialogs>> {
    +run(runner)
    +cancel()
    +signals: progress, finished, failed
  }
  class VaImportService <<вне фазы (E2)>> {
    +import_file(path) : ModelEntry
    +diagnostics : list[Diagnostic]
  }
  class ResultStore {
    +put(result) : str
    +get(id) : StoredResult
    +export_csv(result, names, path) : Path
  }
  ProjectService --> ProjectDoc
  ProjectService --> ProjectSchema
  ProjectService --> ModelManager
  Netlister --> ProjectDoc
  Netlister --> ModelManager
  ResultStore --> ResultMeta
}

package "rcad.ui (PySide6)" {
  class CanvasApi <<Qt-free фасад>> {
    +canvas_state(cell) : dict
    +place(inst, master, x, y, cell)
    +set_params(cell, inst, params)
    +instance_params(cell, inst) : dict
    +build_netlist(cell, dc/tran/ac) : str
  }
  class MainWindow {
    +library: LibraryPanel
    +scene: SchematicScene
    +properties: PropertyPanel
    +log: MessageLog
    +open_project(path)
  }
  class SchematicScene {
    +sync()
    +place(instance)
    +snap(x, y)
    +undo_stack: QUndoStack
  }
  class LibraryPanel
  class PropertyPanel {
    +bind(instance)
    +show_params(specs, values)
  }
  class HierarchyNavigator
  class NetlistView {
    +refresh_cell(cell)
  }
  class AnalysisDialog {
    +build_spec() : AnalysisSpec
    +selected_series() : list[str]
  }
  class PlotWindow {
    +plot_names(series)
    +export_png(path)
    +export_csv(names, path)
  }
  class MessageLog {
    +append(diag: Diagnostic)
    +clear_log()
  }
  class UndoCommand <<QUndoCommand>>

  MainWindow *-- LibraryPanel
  MainWindow *-- SchematicScene
  MainWindow *-- PropertyPanel
  MainWindow *-- MessageLog
  MainWindow --> HierarchyNavigator
  MainWindow --> NetlistView
  MainWindow --> AnalysisDialog
  SchematicScene --> UndoCommand
}

' Связи UI-API → сервисы (Qt-free): модульные функции
CanvasApi ..> Netlister : netlist_for / resolve_bindings
CanvasApi ..> ProjectDoc
CanvasApi ..> ModelManager : entry / params_for
AnalysisDialog ..> ProjectDoc
AnalysisDialog ..> SimulatorService
PlotWindow ..> ResultStore
SchematicScene ..> CanvasApi : геометрия выводов
PropertyPanel ..> ModelManager : ParamSpec

note bottom of CanvasApi
  Qt-free: rcad.ui.api и rcad.services не импортируют
  PySide6 (проверяет tests/unit/test_layering.py).
end note

@enduml
