@startuml
actor Инженер as U
participant "SchematicEditor" as Ed
participant "SchematicView" as Sv
participant "Instance\n(прибор)" as I
participant "IndependentSource" as Ind
participant "Waveform" as Wf
participant "ControlledSource" as Dep
participant "ControlInput" as CI
participant "BehavioralSource" as Bs
participant "MutualCoupling" as Mc
participant "Ground" as Gnd
participant "CdfParameter" as P
participant "Netlister" as N
participant "Netlist\n(CDL/Spectre)" as NL

U -> Ed : Netlist > Run
Ed -> Sv : обойти иерархию сверху вниз
loop каждый Instance
  Sv -> I : getRef()
  I -> Sv : master View (schematic/symbol)
  Sv -> P : resolve(paramOverrides)
  P --> I : итоговые значения\n(override > CDF default > callback)
  alt независимый источник
    Sv -> Ind : getSourceExpression()
    Ind -> Wf : toNetlistExpr()
    Wf --> Ind : "SIN(0 1 1G)" /\n"PULSE(0 1 2n 10p 10p 1n 2n)"
  else управляемый источник / ключ
    Sv -> Dep : resolveControl()
    Dep -> CI : resolve()
    alt тип voltage
      CI --> Dep : пара цепей (n+, n-)
    else тип current
      CI --> Dep : имя пробника\n(0V-источник в ветви)
    end
    Dep --> Sv : "E1 out 0 net 10" /\n"F1 out 0 Vsense 5"
  else поведенческий источник
    Sv -> Bs : getExpression()
    alt выражение задано формулой
      Bs --> Sv : "B1 out 0 V=tanh(...)"
    else задан Verilog-A
      Sv -> Bs : getVAModule()
      Bs --> Sv : имя модуля + параметры
    end
  else магнитная связь
    Sv -> Mc : getCoupling()
    Mc --> Sv : "k12 L1 L2 0.98"
  else земля
    Sv -> Gnd : getNetName()
    Gnd --> Sv : "gnd! -> узел 0"
  end
  I --> Sv : линии, порты, параметры
end
Sv -> Sv : разрешить имена цепей\n(Netlabel, global nets, привязка gnd!)
Sv -> N : передать дерево + приборы + цепи
N -> N : замена приборов на ссылки\nна модели технологии,\nидеальные R/C/L — в spice-форму
N --> NL : записать подсхемы, элементы,\nисточники E/G/F/H/B и строки k
NL --> U : netlist готов
@enduml
