@startuml seq_subckt_hierarchy
title Последовательность: разворачивание иерархии subckt 3 уровня (T12, S4, FR-NL-007…008)

actor "Инженер" as U
participant "NetlistView /\nNetlist Parser" as PAR
participant "Netlist AST" as AST
participant "Flattener" as FLAT
participant "NodeIndex" as NIDX
participant "MnaStructure" as MNA

U -> PAR : открыть crossbar_4x4 netlist
PAR -> AST : parse(.subckt mem_cell,\n.subckt col,\n.subckt crossbar)
AST --> PAR : дерево элементов

PAR -> FLAT : flatten(top="crossbar")
activate FLAT
FLAT -> FLAT : развернуть crossbar → 4 × col
FLAT -> FLAT : развернуть col → 4 × mem_cell
FLAT -> FLAT : развернуть mem_cell → M1 + Xmem\n(глубина 3)
FLAT -> NIDX : назначить имена узлов\nс сохранением пути
NIDX --> FLAT : X1.X2.Xmem.top → id=N
FLAT -> FLAT : слить узлы с совпадающими\nnet-именами, 0 ≡ gnd
FLAT -> FLAT : применить param=val\nк инстансам наследника
FLAT -> MNA : FlatCircuit(инстансы, SV-offset)
MNA --> FLAT : структура (однократно, CSR)
FLAT --> PAR : 16 инстансов мемристора
deactivate FLAT

PAR --> U : netlist-вью и схема идентичны\nплоской (T12, S4: токи по столбцам)

note over FLAT
  Идентичность плоской схеме проверяется
  сравнением ряда токов побитово-эквивалентно
  в допуске golden (reltol=1e-3).
end note

@enduml
