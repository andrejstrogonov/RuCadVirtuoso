l2 : refCell = mind\nl = 10n, rSeries = 2
mut : k = 0.98
sw1 : rOn = 1, rOff = 1G\nvtOn = 0.6, vtOff = 0.4
mem1 : model = vteam_hp
vdd : prefix = vpwl\ndc = 1.2
e1 : gain = 10\ncontrol = пара цепей (in, in_ref)
g1 : gm = 1m\ncontrol = пара цепей (fb, fb_ref)
